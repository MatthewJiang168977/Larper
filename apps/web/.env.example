# Copy to apps/web/.env.local and fill in the two keys from your Clerk app
# (dashboard.clerk.com -> your app -> Configure -> API keys; use the Development instance).
# .env.local is gitignored. scripts/up.sh passes the publishable key to the API in the
# cluster; the load tests read the secret key from here.

NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_replace_me
CLERK_SECRET_KEY=sk_test_replace_me

# Where the app's own sign-in pages live (app/sign-in, app/sign-up).
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/

# Where the browser calls the API. Required for a production build (Vercel: set it in
# the project's environment variables, e.g. https://api.example.com); the API must list
# this app's origin in api.cors.origins and clerk.authorizedParties (Helm).
# NEXT_PUBLIC_API_URL=http://localhost:8080

# Local dev without NEXT_PUBLIC_API_URL: `next dev` proxies /api/* to API_URL (the k3d
# ingress, default http://localhost:8080). Never used in production.
# API_URL=http://localhost:8080

# The public demo (Vercel). "restricted" matches Clerk's Restricted sign-up mode
# (dashboard -> Configure -> Restrictions) and hides the sign-in form's "Sign up" link.
# NEXT_PUBLIC_SIGNUP_MODE=restricted
# The shared demo account, shown on the sign-in page (public on purpose; created and
# reset by scripts/demo-account.sh). Leave unset to show nothing.
# NEXT_PUBLIC_DEMO_EMAIL=demo@playlarper.com
# NEXT_PUBLIC_DEMO_PASSWORD=
