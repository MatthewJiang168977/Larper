# Copy to apps/web/.env.local and fill in the two keys from your Clerk app
# (dashboard.clerk.com -> your app -> Configure -> API keys; use the Development instance).
# .env.local is gitignored. scripts/up.sh passes the publishable key to the API in the
# cluster; the load tests read the secret key from here.

NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_replace_me
CLERK_SECRET_KEY=sk_test_replace_me

# Where the app's own sign-in pages live (app/sign-in, app/sign-up).
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/

# The API the dev server proxies /api/* to (the k3d ingress). Default: http://localhost:8080
# API_URL=http://localhost:8080
