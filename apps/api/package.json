    "@nestjs/platform-express": "^11.2.7",
    "@nestjs/throttler": "^6.7.1",
    "ioredis": "^5.11.1",
    "jose": "^6.2.12",
    "ngeohash": "^0.6.4",
    "pg": "^8.23.1",
    "prom-client": "^15.1.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
