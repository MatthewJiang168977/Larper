{
  "uid": "larper-api",
  "title": "Larper API",
  "tags": [
    "larper"
  ],
  "timezone": "browser",
  "refresh": "10s",
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "schemaVersion": 39,
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "GET /quests/today latency",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 9
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "legendFormat": "p95",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(http_request_duration_seconds_bucket{route=\"/quests/today\"}[1m])))"
        },
        {
          "refId": "B",
          "legendFormat": "p50",
          "expr": "histogram_quantile(0.50, sum by (le) (rate(http_request_duration_seconds_bucket{route=\"/quests/today\"}[1m])))"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Requests / s by status",
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 9
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "legendFormat": "{{status}}",
          "expr": "sum by (status) (rate(http_request_duration_seconds_count{route!=\"unmatched\"}[1m]))"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "API replicas (HPA)",
      "gridPos": {
        "x": 0,
        "y": 9,
        "w": 12,
        "h": 9
      },
      "fieldConfig": {
        "defaults": {
          "decimals": 0
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "legendFormat": "desired",
          "expr": "max(kube_horizontalpodautoscaler_status_desired_replicas{horizontalpodautoscaler=\"api\"})"
        },
        {
          "refId": "B",
          "legendFormat": "ready",
          "expr": "max(kube_deployment_status_replicas_ready{deployment=\"api\"})"
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "API CPU per pod (vs. request)",
      "gridPos": {
        "x": 12,
        "y": 9,
        "w": 12,
        "h": 9
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "legendFormat": "{{pod}}",
          "expr": "sum by (pod) (rate(container_cpu_usage_seconds_total{container=\"api\"}[1m])) / on (pod) group_left sum by (pod) (kube_pod_container_resource_requests{container=\"api\", resource=\"cpu\"})"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Event-loop lag p99",
      "gridPos": {
        "x": 0,
        "y": 18,
        "w": 24,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "legendFormat": "{{pod}}",
          "expr": "nodejs_eventloop_lag_p99_seconds{job=\"api\"}"
        }
      ]
    }
  ]
}
